<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <stroke
                android:width="1.0dip"
                android:color="@color/detailsBackgroundBorder" />
            <padding
                android:left="0.0dip"
                android:top="0.0dip"
                android:right="0.0dip"
                android:bottom="0.0dip" />
        </shape>
    </item>
    <item
        android:bottom="1.0dip">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/detailsBackground" />
            <padding
                android:left="0.0dip"
                android:top="0.0dip"
                android:right="0.0dip"
                android:bottom="0.0dip" />
        </shape>
    </item>
</layer-list>