<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:background="@drawable/listview_selector"
    android:padding="10.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/list_leading_icons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/list_leading_icon"
            android:visibility="gone"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/rbsk_defect_category_dot"
            android:contentDescription="@null"
            android:layout_marginEnd="10.0dip" />
        <ImageView
            android:id="@id/list_leading_icon_2"
            android:visibility="gone"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="4.0dip"
            android:src="@drawable/rbsk_defect_category_dot"
            android:contentDescription="@null"
            android:layout_marginEnd="10.0dip" />
        <ImageView
            android:id="@id/list_leading_icon_3"
            android:visibility="gone"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginTop="4.0dip"
            android:src="@drawable/rbsk_defect_category_dot"
            android:contentDescription="@null"
            android:layout_marginEnd="10.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="15.0sp"
            android:textStyle="bold"
            android:textColor="@color/listview_text_color_selector"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/list_first_text_bold"
            android:paddingBottom="4.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginEnd="30.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="2.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="@style/ListTextView"
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="@color/listview_text_color_selector"
                android:gravity="center_vertical"
                android:id="@id/list_second_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:fontFamily="@font/roboto_bold" />
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="@style/ListTextView"
                android:textSize="13.0sp"
                android:textColor="@color/listview_text_color_selector"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@id/list_second_text_regular"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:lines="1"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginEnd="30.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="@style/ListTextView"
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="@color/listview_text_color_selector"
                android:gravity="center_vertical"
                android:id="@id/list_third_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:fontFamily="@font/roboto_bold" />
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="@style/ListTextView"
                android:textSize="13.0sp"
                android:textColor="@color/listview_text_color_selector"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@id/list_third_text_regular"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:lines="1"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginEnd="30.0dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>