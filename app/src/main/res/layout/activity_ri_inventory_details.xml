<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TableLayout
        android:id="@id/tableLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">
        <TableRow
            android:gravity="center"
            android:id="@id/header_title"
            android:background="@color/placeHolderTextColor"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:padding="8.0dip"
                android:layout_width="0.0dip"
                android:text="@string/vaccines"
                android:layout_weight="1.0" />
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8.0dip"
                android:layout_width="0.0dip"
                android:text="@string/new_vials_available"
                android:layout_weight="1.0" />
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8.0dip"
                android:layout_width="0.0dip"
                android:text="@string/open_vials_available"
                android:layout_weight="1.0" />
        </TableRow>
        <TableRow
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:id="@id/vaccineName"
                android:padding="8.0dip"
                android:layout_width="0.0dip"
                android:text="@string/name"
                android:width="40.0dip"
                android:layout_weight="1.0" />
            <TextView
                android:gravity="center"
                android:id="@id/newVialsReceived"
                android:padding="8.0dip"
                android:layout_width="0.0dip"
                android:text="@string/_0"
                android:layout_weight="1.0" />
            <TextView
                android:gravity="center"
                android:id="@id/openVialsReceived"
                android:padding="8.0dip"
                android:layout_width="0.0dip"
                android:text="@string/_0"
                android:layout_weight="1.0" />
        </TableRow>
    </TableLayout>
</LinearLayout>