<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/bodyBackground"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        layout="@layout/toolbar" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@id/help_refresh"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="16.0dip"
                android:paddingBottom="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16.0dip"
                android:paddingEnd="16.0dip">
                <TextView
                    android:textSize="19.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/textColor"
                    android:id="@id/help_heading"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4.0dip" />
                <ProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@id/help_loading"
                    android:visibility="gone"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginTop="48.0dip"
                    android:indeterminateTint="@color/colorPrimary" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/help_list"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@id/help_empty"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48.0dip">
                    <ImageView
                        android:id="@id/help_empty_icon"
                        android:background="@drawable/support_record_idle"
                        android:padding="20.0dip"
                        android:layout_width="80.0dip"
                        android:layout_height="80.0dip"
                        android:src="@drawable/ic_support_headset"
                        android:tint="@color/colorPrimary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/textColor"
                        android:gravity="center"
                        android:id="@id/help_empty_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textColor="@color/support_muted"
                        android:gravity="center"
                        android:id="@id/help_empty_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6.0dip" />
                    <com.google.android.material.button.MaterialButton
                        android:textSize="16.0sp"
                        android:id="@id/help_retry"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="52.0dip"
                        android:layout_marginTop="16.0dip"
                        android:textAllCaps="false"
                        app:cornerRadius="26.0dip"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <FrameLayout
        android:paddingTop="8.0dip"
        android:paddingBottom="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip">
        <com.google.android.material.button.MaterialButton
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:id="@id/help_raise"
            android:layout_width="fill_parent"
            android:layout_height="60.0dip"
            android:textAllCaps="false"
            android:letterSpacing="0.0"
            app:cornerRadius="30.0dip"
            app:icon="@drawable/ic_support_mic"
            app:iconGravity="textStart"
            app:iconSize="24.0dip" />
    </FrameLayout>
</LinearLayout>