<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@android:color/transparent"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/loading_layout"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <include
            layout="@layout/my_video_view_on_loading_layout" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@id/error_layout"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <include
            layout="@layout/my_video_view_on_error_layout" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/title_part"
        android:background="@color/video_view_titlebar"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_alignParentTop="true">
        <ImageButton
            android:gravity="center"
            android:id="@id/back_btn"
            android:background="#00000000"
            android:visibility="invisible"
            android:layout_width="30.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_menu_back"
            android:scaleType="centerInside"
            android:contentDescription="@string/back"
            android:layout_marginStart="20.0dip" />
        <TextView
            android:textSize="15.0sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@id/title"
            android:paddingLeft="30.0dip"
            android:paddingRight="30.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:singleLine="true"
            android:layout_marginEnd="50.0dip" />
    </LinearLayout>
    <ImageView
        android:id="@id/center_play_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/my_video_view_play"
        android:scaleType="fitXY"
        android:layout_centerInParent="true"
        android:contentDescription="@null" />
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@id/control_layout"
        android:background="@color/video_view_titlebar"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_alignParentBottom="true">
        <ImageButton
            android:gravity="center"
            android:id="@id/turn_button"
            android:background="#00000000"
            android:padding="10.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/my_video_view_player_btn"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginStart="3.0dip"
            android:layout_alignParentStart="true" />
        <ImageButton
            android:id="@id/scale_button"
            android:background="#00000000"
            android:padding="10.0dip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_fullscreen_enter"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="3.0dip"
            android:layout_alignParentEnd="true" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_toStartOf="@id/scale_button"
            android:layout_toEndOf="@id/turn_button">
            <TextView
                android:textColor="@color/video_view_light_gray"
                android:layout_gravity="center_vertical"
                android:id="@id/has_played"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_00_00"
                android:layout_marginStart="10.0dip" />
            <SeekBar
                android:layout_gravity="center"
                android:id="@id/seekbar"
                android:paddingLeft="10.0dip"
                android:paddingRight="10.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:maxHeight="2.0dip"
                android:indeterminateDrawable="@drawable/my_video_view_star_play_progress_seek"
                android:progressDrawable="@drawable/my_video_view_star_play_progress_seek"
                android:minHeight="2.0dip"
                android:thumb="@drawable/my_video_view_seek_dot"
                android:thumbOffset="10.0dip"
                android:layout_weight="1.0" />
            <TextView
                android:textColor="@color/video_view_light_gray"
                android:layout_gravity="center_vertical"
                android:id="@id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_00_00"
                android:layout_marginEnd="10.0dip" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>