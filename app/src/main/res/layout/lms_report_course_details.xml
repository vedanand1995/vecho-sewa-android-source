<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.0dip"
        android:weightSum="10.0">
        <ImageView
            android:id="@id/course_image"
            android:layout_width="0.0dip"
            android:layout_height="120.0dip"
            android:src="@drawable/lms_my_courses"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_weight="3.33" />
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/CustomSubtitleView"
            android:id="@id/course_title"
            android:padding="10.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="6.66"
            android:textAllCaps="true"
            android:layout_marginStart="10.0dip" />
    </LinearLayout>
    <View
        android:background="#ffd3d3d3"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="10.0">
        <View
            android:background="#ffd3d3d3"
            android:layout_width="1.0dip"
            android:layout_height="fill_parent" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="3.33">
            <com.google.android.material.textview.MaterialTextView
                android:textSize="13.0sp"
                android:id="@id/time_spent_label"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Time\nSpent"
                android:textAllCaps="true"
                android:textAlignment="center" />
            <com.google.android.material.textview.MaterialTextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/answer"
                android:gravity="center"
                android:id="@id/time_spent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="23 h 13 m"
                android:textAlignment="center" />
        </LinearLayout>
        <View
            android:background="#ffd3d3d3"
            android:layout_width="1.0dip"
            android:layout_height="fill_parent" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="3.33">
            <com.google.android.material.textview.MaterialTextView
                android:textSize="13.0sp"
                android:id="@id/completion_status_label"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Completion\nStatus"
                android:textAllCaps="true"
                android:textAlignment="center" />
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@id/progressbar"
                    android:layout_width="80.0dip"
                    android:layout_height="80.0dip"
                    android:max="100"
                    android:progress="25"
                    android:secondaryProgress="100"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress_bar_report"
                    android:layout_centerInParent="true"
                    style="?android:progressBarStyleHorizontal" />
                <TextView
                    android:textSize="16.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/answer"
                    android:gravity="center"
                    android:id="@id/progressbarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25%"
                    android:layout_centerInParent="true" />
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="#ffd3d3d3"
            android:layout_width="1.0dip"
            android:layout_height="fill_parent" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="3.33">
            <com.google.android.material.textview.MaterialTextView
                android:textSize="13.0sp"
                android:id="@id/most_watched_lesson_label"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Most Watched\nLesson"
                android:textAllCaps="true"
                android:textAlignment="center" />
            <com.google.android.material.textview.MaterialTextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/answer"
                android:gravity="center"
                android:id="@id/most_watched_lesson"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:text="Lesson 4"
                android:textAlignment="center" />
        </LinearLayout>
        <View
            android:background="#ffd3d3d3"
            android:layout_width="1.0dip"
            android:layout_height="fill_parent" />
    </LinearLayout>
    <View
        android:background="#ffd3d3d3"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
</LinearLayout>