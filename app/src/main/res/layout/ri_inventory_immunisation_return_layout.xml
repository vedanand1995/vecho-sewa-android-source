<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@id/vaccineName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vaccines"
        style="@style/CustomLabelView" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/fullVialsLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="10.0">
        <TextView
            android:layout_gravity="center"
            android:id="@id/newVialsText"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/full_vials"
            android:layout_weight="2.0"
            android:layout_marginEnd="10.0dip"
            style="@style/LastUpdateLabel" />
        <HorizontalScrollView
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="8.0">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@id/newVials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_0" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_1" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_2" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_3" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_4" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_5" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_6" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_7" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_8" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_9" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_10" />
            </RadioGroup>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/openVialsLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="10.0">
        <TextView
            android:layout_gravity="center"
            android:id="@id/openVialsText"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/half_vials"
            android:layout_weight="2.0"
            android:layout_marginEnd="10.0dip"
            style="@style/LastUpdateLabel" />
        <HorizontalScrollView
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="8.0">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@id/openVials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_0" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_1" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_2" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_3" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_4" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_5" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_6" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_7" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_8" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_9" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_10" />
            </RadioGroup>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/emptyVialsLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="10.0">
        <TextView
            android:layout_gravity="center"
            android:id="@id/emptyVialsText"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/empty_vials"
            android:layout_weight="2.0"
            android:layout_marginEnd="10.0dip"
            style="@style/LastUpdateLabel" />
        <HorizontalScrollView
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="8.0">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@id/emptyVials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_0" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_1" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_2" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_3" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_4" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_5" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_6" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_7" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_8" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_9" />
                <RadioButton
                    android:padding="0.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_10" />
            </RadioGroup>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>