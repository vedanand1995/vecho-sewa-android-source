<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:background="@drawable/listview_selector"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.google.android.material.textview.MaterialTextView
        android:textAppearance="@style/ListTextView"
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listview_text_color_selector"
        android:gravity="center_vertical"
        android:id="@id/list_text_bold"
        android:padding="10.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:fontFamily="@font/roboto_bold" />
    <com.google.android.material.textview.MaterialTextView
        android:textAppearance="@style/ListTextView"
        android:textSize="14.0sp"
        android:textColor="@color/listview_text_color_selector"
        android:gravity="center_vertical"
        android:id="@id/list_text_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dash"
        android:lines="1"
        android:fontFamily="@font/roboto_regular" />
    <com.google.android.material.textview.MaterialTextView
        android:textAppearance="@style/ListTextView"
        android:textSize="14.0sp"
        android:textColor="@color/listview_text_color_selector"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@id/list_text_regular"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginEnd="30.0dip" />
</LinearLayout>