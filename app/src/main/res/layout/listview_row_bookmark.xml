<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/lms_listview_bookmark_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:listPreferredItemHeight"
    android:paddingStart="5.0dip"
    android:paddingEnd="5.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="1.0">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/listview_text_color_selector"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@id/bookmark_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="0.85"
            app:fontFamily="@font/roboto_bold" />
        <com.google.android.material.textview.MaterialTextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@color/listview_text_color_selector"
            android:id="@id/bookmark_duration"
            android:padding="5.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="0.15"
            android:fontFamily="@font/roboto_bold" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:weightSum="1.0">
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="12.0sp"
            android:textColor="@color/listview_text_color_selector"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/bookmark_note"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:lines="2"
            android:layout_weight="0.7"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginEnd="30.0dip" />
        <ImageButton
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/bookmark_play"
            android:background="@color/transparent"
            android:padding="10.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_play"
            android:adjustViewBounds="true"
            android:tint="@color/lms_bookmark_edit_button_selector"
            android:layout_weight="0.1" />
        <ImageButton
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/edit_bookmark"
            android:background="@color/transparent"
            android:padding="10.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_edit"
            android:adjustViewBounds="true"
            android:tint="@color/lms_bookmark_edit_button_selector"
            android:layout_weight="0.1" />
        <ImageButton
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/delete_bookmark"
            android:background="@color/transparent"
            android:padding="10.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/ic_delete"
            android:adjustViewBounds="true"
            android:tint="@color/lms_bookmark_edit_button_selector"
            android:layout_weight="0.1" />
    </LinearLayout>
</LinearLayout>