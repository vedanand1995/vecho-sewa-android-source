<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:background="@drawable/listview_selector"
    android:padding="10.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="0.9">
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/placeHolderTextColor"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@id/list_text_title"
            android:paddingBottom="2.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginEnd="30.0dip" />
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/listview_text_color_selector"
            android:gravity="center_vertical"
            android:id="@id/list_first_text_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/roboto_bold" />
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/listview_text_color_selector"
            android:gravity="center_vertical"
            android:id="@id/list_second_text_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="@font/roboto_bold" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|center"
        android:id="@id/abhaNumberImageView"
        android:visibility="gone"
        android:layout_width="32.0dip"
        android:layout_height="32.0dip"
        android:src="@drawable/ic_medical_card"
        android:layout_weight="0.1"
        android:layout_marginEnd="16.0dip" />
</LinearLayout>