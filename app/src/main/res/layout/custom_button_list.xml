<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/listview_button_selector"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5.0dip"
            android:layout_marginTop="10.0dip"
            android:minHeight="?android:listPreferredItemHeight">
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="@style/CustomAnswerView"
                android:textStyle="bold"
                android:textColor="@drawable/listview_button_color_selector"
                android:gravity="center"
                android:id="@id/lists_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:fontFamily="@font/roboto_bold" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@id/session_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text="@string/_0" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@id/session_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="@string/_0" />
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center|top"
            android:id="@id/activeSessionBadge"
            android:visibility="gone"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:layout_marginTop="10.0dip"
            android:src="@drawable/active_notification_badge"
            android:layout_marginEnd="10.0dip" />
    </FrameLayout>
</LinearLayout>