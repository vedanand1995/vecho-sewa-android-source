<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12.0dip"
    android:layout_marginTop="6.0dip"
    android:layout_marginRight="12.0dip"
    android:layout_marginBottom="6.0dip"
    android:foreground="?android:selectableItemBackground"
    app:cardCornerRadius="4.0dip"
    app:cardElevation="1.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:id="@id/member_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8.0dip"
            app:layout_constraintEnd_toStartOf="@id/member_due_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="#ff555555"
            android:gravity="start"
            android:id="@id/member_id"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            app:layout_constraintEnd_toStartOf="@id/guidelineVertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/member_name" />
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark"
            android:gravity="end"
            android:id="@id/member_due_date"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/member_id"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guidelineVertical"
            app:layout_constraintTop_toTopOf="@id/member_id" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="#ff555555"
            android:gravity="start"
            android:id="@id/member_edd"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            app:layout_constraintEnd_toStartOf="@id/guidelineVertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/member_id" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineVertical"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            app:layout_constraintGuide_percent="0.5" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@android:color/holo_red_dark"
            android:gravity="start"
            android:id="@id/high_risk"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            app:layout_constraintEnd_toStartOf="@id/guidelineVertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/member_edd" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="#ff555555"
            android:gravity="end"
            android:id="@id/member_lmp"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/member_edd"
            app:layout_constraintTop_toBottomOf="@id/member_due_date" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>