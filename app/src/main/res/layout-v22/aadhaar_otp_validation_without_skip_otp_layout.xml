<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.textview.MaterialTextView
        android:textSize="20.0dip"
        android:id="@id/description"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30.0dip"
        android:layout_marginBottom="30.0dip"
        android:text="@string/description"
        android:textAlignment="center"
        android:layout_marginStart="5.0dip"
        android:layout_marginVertical="30.0dip"
        style="@style/CustomQuestionView" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@id/otpText"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:endIconMode="password_toggle"
        app:hintEnabled="false">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_verification_code"
            android:maxLength="6"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:textSize="12.0sp"
        android:id="@id/verifyOtpBtn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.0dip"
        android:text="@string/verify_verification_code" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.0dip"
        android:weightSum="10.0">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="14.0sp"
            android:textColor="@color/labelColor"
            android:id="@id/resend"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/resend_otp"
            android:layout_weight="3.5"
            android:paddingStart="5.0dip"
            android:paddingEnd="0.0dip" />
        <com.google.android.material.textview.MaterialTextView
            android:textSize="15.0sp"
            android:textColor="@color/black"
            android:id="@id/timer"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/zero_seconds"
            android:layout_weight="2.0"
            android:textAlignment="textEnd" />
    </LinearLayout>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="15.0sp"
        android:textColor="@color/labelColor"
        android:id="@id/cancel_action"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10.0dip"
        android:layout_marginTop="60.0dip"
        android:layout_marginRight="10.0dip"
        android:layout_marginBottom="10.0dip"
        android:text="@string/cancel"
        android:textAlignment="center"
        android:layout_marginHorizontal="10.0dip" />
</LinearLayout>