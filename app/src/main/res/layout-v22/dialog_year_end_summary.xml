<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@drawable/dialog_rounded_bg"
    android:paddingBottom="24.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/ivSummaryIllustration"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="24.0dip"
        android:src="@drawable/your_illustration_image"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="22.0sp"
        android:textStyle="bold"
        android:textColor="@color/summary_text_headline"
        android:gravity="center"
        android:id="@id/tvSummaryHeadline"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24.0dip"
        android:layout_marginTop="24.0dip"
        android:layout_marginRight="24.0dip"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="24.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivSummaryIllustration" />
    <TextView
        android:textSize="16.0sp"
        android:textColor="@color/summary_text_body"
        android:gravity="center"
        android:id="@id/tvSummaryBody"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32.0dip"
        android:layout_marginTop="16.0dip"
        android:layout_marginRight="32.0dip"
        android:text="Thank you for your incredible dedication this year. We’ve prepared a special summary highlighting your impact. Tap below to view it in your browser."
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="32.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSummaryHeadline" />
    <com.google.android.material.button.MaterialButton
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@id/btnViewSummary"
        android:paddingTop="12.0dip"
        android:paddingBottom="12.0dip"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32.0dip"
        android:layout_marginTop="32.0dip"
        android:layout_marginRight="32.0dip"
        android:layout_marginHorizontal="32.0dip"
        android:paddingVertical="12.0dip"
        app:backgroundTint="@color/summary_blue_primary"
        app:cornerRadius="50.0dip"
        app:icon="@drawable/ic_open_in_new"
        app:iconGravity="textEnd"
        app:iconPadding="8.0dip"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSummaryBody"
        style="@style/Widget.MaterialComponents.Button" />
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/summary_text_body"
        android:id="@id/btnNotNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        app:cornerRadius="50.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnViewSummary"
        style="@style/Widget.MaterialComponents.Button.TextButton" />
</androidx.constraintlayout.widget.ConstraintLayout>