.field public static final CONSENT_ANONYMIZATION_GU:Ljava/lang/String; = "\u0ab9\u0ac1\u0a82 \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab9\u0ac7\u0aa4\u0ac1\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0abe \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1\u0aa8\u0abe \u0a85\u0aa8\u0abe\u0aae\u0ac0\u0a95\u0ab0\u0aa3 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0ac1\u0a97\u0abe\u0aae\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82."

.field public static final CONSENT_BENEFICIARY:Ljava/lang/String; = "have been explained about the consent as stated above and hereby provide my consent for the aforementioned purposes."

.field public static final CONSENT_BENEFICIARY_GU:Ljava/lang/String; = "\u0a89\u0aaa\u0ab0 \u0a9c\u0aa3\u0abe\u0ab5\u0acd\u0aaf\u0abe \u0aae\u0ac1\u0a9c\u0aac \u0aae\u0aa8\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0ab5\u0abf\u0ab6\u0ac7 \u0ab8\u0aae\u0a9c\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a86\u0aa5\u0ac0 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0ab9\u0ac7\u0aa4\u0ac1\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa8 \u0a95\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82."

.field public static final CONSENT_FOR_ABHA_USAGE:Ljava/lang/String; = "I consent to usage of my ABHA address and ABHA number for linking of my legacy (past) government health records and those which will be generated during this encounter."

.field public static final CONSENT_FOR_ABHA_USAGE_GU:Ljava/lang/String; = "\u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0ab2\u0ac7\u0a97\u0ab8\u0ac0 (\u0aad\u0ac2\u0aa4\u0a95\u0abe\u0ab3\u0aa8\u0abe) \u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1 \u0a85\u0aa8\u0ac7 \u0a86 \u0a8f\u0aa8\u0acd\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f\u0ab0 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8 \u0a9c\u0ac7 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0aa5\u0ab6\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0ab2\u0abf\u0a82\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0abe\u0ab0\u0abe ABHA \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 ABHA \u0aa8\u0a82\u0aac\u0ab0\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf \u0a86\u0aaa\u0ac1\u0a82 \u0a9b\u0ac1\u0a82."

.field public static final CONSENT_FOR_SHARING_HEALTH_RECORDS:Ljava/lang/String; = "I authorize the sharing of all my health records with healthcare provider(s) for the purpose of providing healthcare services to me during this encounter."

.field public static final CONSENT_FOR_SHARING_HEALTH_RECORDS_GU:Ljava/lang/String; = "\u0a86 \u0a8f\u0aa8\u0acd\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f\u0ab0 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8 \u0aae\u0aa8\u0ac7 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf\u0ab8\u0a82\u0aad\u0abe\u0ab3 \u0ab8\u0ac7\u0ab5\u0abe\u0a93 \u0aaa\u0ac2\u0ab0\u0ac0 \u0aaa\u0abe\u0aa1\u0ab5\u0abe\u0aa8\u0abe \u0ab9\u0ac7\u0aa4\u0ac1\u0aa5\u0ac0 \u0ab9\u0ac1\u0a82 \u0aae\u0abe\u0ab0\u0abe \u0aa4\u0aae\u0abe\u0aae \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1\u0aa8\u0ac7 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf\u0ab8\u0a82\u0aad\u0abe\u0ab3 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa4\u0abe(\u0a93) \u0ab8\u0abe\u0aa5\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa7\u0abf\u0a95\u0ac3\u0aa4 \u0a95\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82."

.field public static final CONSENT_HEADING:Ljava/lang/String; = "I hereby declare that:"

.field public static final CONSENT_HEADING_GU:Ljava/lang/String; = "\u0ab9\u0ac1\u0a82 \u0a86\u0aa5\u0ac0 \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0a95\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7:"

.field public static final CONSENT_HEALTH_WORKER:Ljava/lang/String; = "confirm that I have duly informed and explained the beneficiary of the contents of consent for aforementioned purposes."

.field public static final CONSENT_HEALTH_WORKER_GU:Ljava/lang/String; = "\u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a95\u0ab0\u0ac1\u0a82 \u0a9b\u0ac1\u0a82 \u0a95\u0ac7 \u0aae\u0ac7\u0a82 \u0a89\u0aaa\u0ab0\u0acb\u0a95\u0acd\u0aa4 \u0ab9\u0ac7\u0aa4\u0ac1\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf\u0aa8\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0abe \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0aa8\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0ac0 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab8\u0aae\u0a9c\u0abe\u0ab5\u0ac0 \u0a9b\u0ac7."

.field public static final CONSENT_OTHER_THAN_AADHAAR:Ljava/lang/String; = "I intend to create Ayushman Bharat Health Account Number (\u201cABHA number\u201d) and Ayushman Bharat Health Account address (\u201cABHA Address\u201d) using document other than Aadhaar. (Click here to proceed further)"

.field public static final CONSENT_OTHER_THAN_AADHAAR_GU:Ljava/lang/String; = "\u0ab9\u0ac1\u0a82 \u0a86\u0aaf\u0ac1\u0ab7\u0acd\u0aae\u0abe\u0aa8 \u0aad\u0abe\u0ab0\u0aa4 \u0ab9\u0ac7\u0ab2\u0acd\u0aa5 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0aa8\u0a82\u0aac\u0ab0 (\u201cABHA \u0aa8\u0a82\u0aac\u0ab0\u201d) \u0a85\u0aa8\u0ac7 \u0a86\u0aaf\u0ac1\u0ab7\u0acd\u0aae\u0abe\u0aa8 \u0aad\u0abe\u0ab0\u0aa4 \u0ab9\u0ac7\u0ab2\u0acd\u0aa5 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0a8f\u0aa1\u0acd\u0ab0\u0ac7\u0ab8 (\u201cABHA \u0a8f\u0aa1\u0acd\u0ab0\u0ac7\u0ab8\u201d) \u0ab8\u0abf\u0ab5\u0abe\u0aaf\u0aa8\u0abe \u0a85\u0aa8\u0acd\u0aaf \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aac\u0aa8\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a97\u0ac1\u0a82 \u0a9b\u0ac1\u0a82. \u0a86\u0aa7\u0abe\u0ab0. (\u0ab5\u0aa7\u0ac1 \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab9\u0ac0\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb)"

