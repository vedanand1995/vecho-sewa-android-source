<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="5.0dip"
    android:paddingBottom="5.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/parentLayout"
        android:background="@drawable/custom_datepicker_unselected"
        android:padding="5.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:weightSum="10.0">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/service"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="Service Provided"
                android:layout_weight="5.0" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/count"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="Count"
                android:layout_weight="2.0" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/amount"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="Amount"
                android:layout_weight="2.0" />
            <ImageView
                android:id="@id/downArrow"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:src="@drawable/ic_arrow_down"
                android:tint="@color/black"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/memberDetailsLayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@id/totalAmountCard"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8.0dip"
        app:cardCornerRadius="4.0dip"
        app:cardElevation="4.0dip">
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
            android:textColor="@color/black"
            android:id="@id/totalAmountLabel"
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </androidx.cardview.widget.CardView>
</LinearLayout>