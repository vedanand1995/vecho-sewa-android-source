<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/bodyBackground"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        layout="@layout/toolbar" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@id/ticket_refresh"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <ScrollView
            android:id="@id/ticket_scroll"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="16.0dip"
                android:paddingBottom="24.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16.0dip"
                android:paddingEnd="16.0dip">
                <ProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@id/ticket_loading"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_marginTop="48.0dip"
                    android:indeterminateTint="@color/colorPrimary" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/ticket_content"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/support_card"
                        android:padding="16.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:id="@id/head_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:textSize="18.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/textColor"
                            android:id="@id/ticket_title"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10.0dip" />
                        <TextView
                            android:textSize="13.0sp"
                            android:textColor="@color/support_muted"
                            android:id="@id/ticket_meta"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.0dip" />
                        <com.google.android.material.button.MaterialButton
                            android:textSize="14.0sp"
                            android:textColor="@color/support_tone_warning_ink"
                            android:id="@id/ticket_reopen"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="44.0dip"
                            android:textAllCaps="false"
                            android:layout_marginStart="-8.0dip"
                            app:icon="@drawable/ic_support_replay"
                            app:iconTint="@color/support_tone_warning_ink"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />
                        <View
                            android:id="@id/head_divider"
                            android:background="@color/support_line"
                            android:layout_width="fill_parent"
                            android:layout_height="1.0dip"
                            android:layout_marginTop="14.0dip" />
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@id/ticket_track"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14.0dip"
                            android:paddingStart="4.0dip"
                            android:paddingEnd="4.0dip">
                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@id/track_dot1"
                                    android:padding="5.0dip"
                                    android:layout_width="24.0dip"
                                    android:layout_height="24.0dip"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:textSize="12.0sp"
                                    android:id="@id/track_label1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4.0dip" />
                            </LinearLayout>
                            <View
                                android:id="@id/track_line1"
                                android:layout_width="0.0dip"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="11.0dip"
                                android:layout_weight="1.0"
                                android:layout_marginStart="6.0dip"
                                android:layout_marginEnd="6.0dip" />
                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@id/track_dot2"
                                    android:padding="5.0dip"
                                    android:layout_width="24.0dip"
                                    android:layout_height="24.0dip"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:textSize="12.0sp"
                                    android:id="@id/track_label2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4.0dip" />
                            </LinearLayout>
                            <View
                                android:id="@id/track_line2"
                                android:layout_width="0.0dip"
                                android:layout_height="2.0dip"
                                android:layout_marginTop="11.0dip"
                                android:layout_weight="1.0"
                                android:layout_marginStart="6.0dip"
                                android:layout_marginEnd="6.0dip" />
                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@id/track_dot3"
                                    android:padding="5.0dip"
                                    android:layout_width="24.0dip"
                                    android:layout_height="24.0dip"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:textSize="12.0sp"
                                    android:id="@id/track_label3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4.0dip" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textSize="14.0sp"
                            android:textColor="@color/support_muted"
                            android:id="@id/head_detail"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/note_pending"
                        android:padding="14.0dip"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@id/note_pending_icon"
                                android:layout_width="22.0dip"
                                android:layout_height="22.0dip"
                                android:src="@drawable/ic_support_sync_arrows"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:textSize="15.0sp"
                                android:textColor="@color/textColor"
                                android:id="@id/note_pending_body"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.0"
                                android:layout_marginStart="12.0dip" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:textSize="16.0sp"
                            android:textStyle="bold"
                            android:id="@id/note_pending_sync"
                            android:layout_width="fill_parent"
                            android:layout_height="52.0dip"
                            android:layout_marginTop="10.0dip"
                            android:textAllCaps="false"
                            android:letterSpacing="0.0"
                            app:cornerRadius="26.0dip"
                            app:icon="@drawable/ic_support_sync_arrows"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/note_ask"
                        android:padding="14.0dip"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip">
                        <ImageView
                            android:layout_width="22.0dip"
                            android:layout_height="22.0dip"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:layout_marginStart="12.0dip">
                            <TextView
                                android:textSize="15.0sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:textSize="15.0sp"
                                android:textColor="@color/textColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dip" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/note_fixed"
                        android:padding="14.0dip"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip">
                        <ImageView
                            android:layout_width="22.0dip"
                            android:layout_height="22.0dip"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:layout_marginStart="12.0dip">
                            <TextView
                                android:textSize="15.0sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:textSize="15.0sp"
                                android:textColor="@color/textColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dip" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/note_closed"
                        android:padding="14.0dip"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.0dip">
                        <ImageView
                            android:layout_width="22.0dip"
                            android:layout_height="22.0dip"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:layout_marginStart="12.0dip">
                            <TextView
                                android:textSize="15.0sp"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:textSize="15.0sp"
                                android:textColor="@color/textColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dip" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="13.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/support_muted"
                        android:id="@id/ticket_report_label"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:layout_marginBottom="8.0dip"
                        android:textAllCaps="true"
                        android:paddingStart="4.0dip"
                        android:letterSpacing="0.04" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/ticket_report"
                        android:background="@drawable/support_card"
                        android:padding="12.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@id/report_voice"
                            android:visibility="gone"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <ImageButton
                                android:id="@id/report_play"
                                android:background="@drawable/support_mic_circle"
                                android:padding="13.0dip"
                                android:layout_width="48.0dip"
                                android:layout_height="48.0dip"
                                android:src="@drawable/ic_support_play"
                                android:scaleType="fitCenter"
                                android:tint="@color/white" />
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.0"
                                android:layout_marginStart="12.0dip">
                                <TextView
                                    android:textSize="16.0sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textColor"
                                    android:id="@id/report_voice_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                                <TextView
                                    android:textSize="13.0sp"
                                    android:textColor="@color/support_muted"
                                    android:id="@id/report_voice_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2.0dip" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:textSize="15.0sp"
                            android:textColor="@color/textColor"
                            android:id="@id/report_text"
                            android:visibility="gone"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10.0dip" />
                        <HorizontalScrollView
                            android:id="@id/report_photos_strip"
                            android:visibility="gone"
                            android:scrollbars="none"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10.0dip">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@id/report_photos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </HorizontalScrollView>
                    </LinearLayout>
                    <TextView
                        android:textSize="13.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/support_muted"
                        android:id="@id/ticket_details_label"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:layout_marginBottom="8.0dip"
                        android:textAllCaps="true"
                        android:paddingStart="4.0dip"
                        android:letterSpacing="0.04" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/ticket_details"
                        android:background="@drawable/support_card"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/support_muted"
                        android:id="@id/ticket_messages_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:layout_marginBottom="8.0dip"
                        android:textAllCaps="true"
                        android:paddingStart="4.0dip"
                        android:letterSpacing="0.04" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@id/ticket_messages"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView
                    android:textSize="17.0sp"
                    android:textColor="@color/support_muted"
                    android:gravity="center"
                    android:id="@id/ticket_error"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48.0dip" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ticket_fixed_bar"
        android:background="@drawable/support_bottom_bar"
        android:paddingTop="12.0dip"
        android:paddingBottom="14.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip">
        <TextView
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:textColor="@color/textColor"
            android:gravity="center"
            android:id="@id/ticket_fixed_question"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/support_status_answer"
                android:id="@id/ticket_no"
                android:layout_width="0.0dip"
                android:layout_height="58.0dip"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                app:cornerRadius="29.0dip"
                app:icon="@drawable/ic_support_close"
                app:iconGravity="textStart"
                app:iconTint="@color/support_status_answer"
                app:strokeColor="@color/support_status_answer"
                app:strokeWidth="2.0dip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:id="@id/ticket_yes"
                android:layout_width="0.0dip"
                android:layout_height="58.0dip"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                android:layout_marginStart="10.0dip"
                android:backgroundTint="@color/support_status_fixed"
                app:cornerRadius="29.0dip"
                app:icon="@drawable/ic_support_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/ticket_reply_bar"
        android:background="@drawable/support_bottom_bar"
        android:paddingTop="10.0dip"
        android:paddingBottom="12.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12.0dip"
        android:paddingEnd="12.0dip">
        <ImageButton
            android:id="@id/reply_mic"
            android:background="@drawable/support_mic_circle"
            android:padding="14.0dip"
            android:layout_width="50.0dip"
            android:layout_height="50.0dip"
            android:src="@drawable/ic_support_mic"
            android:scaleType="fitCenter"
            android:tint="@color/white" />
        <EditText
            android:textSize="16.0sp"
            android:textColor="@color/textColor"
            android:id="@id/reply_text"
            android:background="@drawable/support_pill_field"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:minHeight="52.0dip"
            android:maxLines="4"
            android:layout_weight="1.0"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingStart="18.0dip"
            android:paddingEnd="18.0dip"
            android:layout_marginStart="10.0dip"
            android:importantForAutofill="no" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/reply_recording"
            android:background="@drawable/support_record_live"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="52.0dip"
            android:layout_weight="1.0"
            android:paddingStart="16.0dip"
            android:paddingEnd="8.0dip"
            android:layout_marginStart="10.0dip">
            <View
                android:background="@drawable/support_red_circle"
                android:layout_width="10.0dip"
                android:layout_height="10.0dip" />
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@color/support_recording_ink"
                android:id="@id/reply_recording_text"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="10.0dip" />
            <ImageButton
                android:id="@id/reply_cancel"
                android:background="?android:selectableItemBackgroundBorderless"
                android:padding="8.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/ic_support_close"
                android:scaleType="fitCenter"
                android:tint="@color/support_recording_ink" />
        </LinearLayout>
        <ImageButton
            android:id="@id/reply_send"
            android:background="@drawable/support_mic_circle"
            android:padding="14.0dip"
            android:visibility="gone"
            android:layout_width="52.0dip"
            android:layout_height="52.0dip"
            android:src="@drawable/ic_support_send"
            android:scaleType="fitCenter"
            android:tint="@color/white"
            android:layout_marginStart="8.0dip" />
        <ProgressBar
            android:id="@id/reply_busy"
            android:visibility="gone"
            android:layout_width="36.0dip"
            android:layout_height="36.0dip"
            android:layout_marginStart="12.0dip"
            android:indeterminateTint="@color/colorPrimary" />
    </LinearLayout>
</LinearLayout>