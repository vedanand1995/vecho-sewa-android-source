<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:orientation="vertical"
    android:background="@drawable/bg_incentive_reapproval"
    android:padding="8.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4.0dip"
    android:layout_marginBottom="4.0dip"
    android:layout_marginVertical="4.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@id/serviceTag"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Service Provided : "
        android:lines="1"
        android:paddingVertical="4.0dip"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.textfield.TextInputEditText
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@id/serviceProvided"
        android:paddingTop="5.0dip"
        android:paddingBottom="3.0dip"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:editable="false"
        android:layout_marginStart="12.0dip"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintBottom_toBottomOf="@id/serviceTag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/serviceTag"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.checkbox.MaterialCheckBox
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@id/checkbox"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Recommend to Mo "
        android:lines="1"
        android:layoutDirection="rtl"
        android:paddingVertical="4.0dip"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/serviceTag" />
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@id/amountTag"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Amount : "
        android:lines="1"
        android:paddingVertical="4.0dip"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/checkbox" />
    <EditText
        android:enabled="false"
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@id/amount_value"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:lines="1"
        android:inputType="number"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintBottom_toBottomOf="@id/amountTag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/amountTag"
        app:layout_constraintTop_toTopOf="@id/amountTag" />
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@id/comment"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="0.0dip"
        android:layout_height="fill_parent"
        android:text="Comments :   "
        android:lines="1"
        android:paddingVertical="4.0dip"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amountTag" />
    <EditText
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@id/comment_value"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:lines="1"
        android:editable="false"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintBottom_toBottomOf="@id/comment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/comment"
        app:layout_constraintTop_toTopOf="@id/comment" />
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@id/memberTag"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="Member Name :     "
        android:layout_weight="0.4"
        android:paddingVertical="4.0dip"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/comment" />
    <EditText
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@color/listTextColor"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@id/memberName"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:editable="false"
        android:layout_weight="0.4"
        app:fontFamily="@font/roboto_bold"
        app:layout_constraintBottom_toBottomOf="@id/memberTag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/memberTag"
        app:layout_constraintTop_toTopOf="@id/memberTag" />
</androidx.constraintlayout.widget.ConstraintLayout>