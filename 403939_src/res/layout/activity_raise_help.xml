<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        layout="@layout/toolbar" />
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        android:layout_weight="1.0">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24.0dip"
            android:paddingBottom="24.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <TextView
                android:textSize="20.0sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:gravity="center"
                android:id="@id/raise_question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/rec_mic_area"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@id/rec_halo"
                    android:background="@drawable/support_mic_halo"
                    android:layout_width="156.0dip"
                    android:layout_height="156.0dip"
                    android:layout_marginTop="20.0dip">
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@id/rec_button"
                        android:background="@drawable/support_mic_circle"
                        android:padding="36.0dip"
                        android:layout_width="124.0dip"
                        android:layout_height="124.0dip"
                        android:src="@drawable/ic_support_mic"
                        android:scaleType="fitCenter"
                        android:tint="@color/white"
                        android:elevation="4.0dip" />
                </FrameLayout>
                <TextView
                    android:textSize="20.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:id="@id/rec_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    android:fontFeatureSettings="tnum" />
                <TextView
                    android:textSize="15.0sp"
                    android:textColor="@color/support_muted"
                    android:gravity="center"
                    android:id="@id/rec_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/rec_done"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:src="@drawable/ic_support_check_circle"
                        android:tint="@color/support_status_fixed"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:textSize="17.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/support_status_fixed"
                        android:id="@id/rec_done_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/rec_player"
                    android:background="@drawable/support_card"
                    android:padding="12.0dip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:foreground="?android:selectableItemBackground">
                    <ImageButton
                        android:id="@id/rec_play"
                        android:background="@drawable/support_mic_circle"
                        android:padding="14.0dip"
                        android:layout_width="52.0dip"
                        android:layout_height="52.0dip"
                        android:src="@drawable/ic_support_play"
                        android:scaleType="fitCenter"
                        android:tint="@color/white" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="14.0dip">
                        <TextView
                            android:textSize="17.0sp"
                            android:textStyle="bold"
                            android:textColor="@color/textColor"
                            android:id="@id/rec_player_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:textSize="14.0sp"
                            android:textColor="@color/support_muted"
                            android:id="@id/rec_length"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.0dip" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:textSize="16.0sp"
                    android:layout_gravity="center_horizontal"
                    android:id="@id/rec_again"
                    android:layout_width="wrap_content"
                    android:layout_height="52.0dip"
                    android:layout_marginTop="4.0dip"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_support_replay"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>
            <TextView
                android:textSize="15.0sp"
                android:textColor="@color/support_muted"
                android:id="@id/raise_also"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28.0dip"
                android:layout_marginBottom="10.0dip" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/choice_photo"
                    android:background="@drawable/support_choice"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0.0dip"
                    android:layout_height="72.0dip"
                    android:foreground="?android:selectableItemBackground"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="6.0dip">
                    <ImageView
                        android:layout_width="26.0dip"
                        android:layout_height="26.0dip"
                        android:src="@drawable/ic_support_camera"
                        android:tint="@color/colorPrimary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/textColor"
                        android:id="@id/choice_photo_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/choice_write"
                    android:background="@drawable/support_choice"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0.0dip"
                    android:layout_height="72.0dip"
                    android:foreground="?android:selectableItemBackground"
                    android:layout_weight="1.0"
                    android:layout_marginStart="6.0dip">
                    <ImageView
                        android:layout_width="26.0dip"
                        android:layout_height="26.0dip"
                        android:src="@drawable/ic_support_pencil"
                        android:tint="@color/colorPrimary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/textColor"
                        android:id="@id/choice_write_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip" />
                </LinearLayout>
            </LinearLayout>
            <HorizontalScrollView
                android:id="@id/photo_strip"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/photo_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>
            <EditText
                android:textSize="16.0sp"
                android:textColor="@color/textColor"
                android:gravity="top"
                android:id="@id/raise_note"
                android:background="@drawable/support_card"
                android:padding="14.0dip"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:maxLines="5"
                android:minLines="3"
                android:inputType="textCapSentences|textMultiLine" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/support_bottom_bar"
        android:paddingTop="12.0dip"
        android:paddingBottom="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip">
            <ImageView
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/ic_support_shield"
                android:tint="@color/support_muted"
                android:importantForAccessibility="no" />
            <TextView
                android:textSize="13.0sp"
                android:textColor="@color/support_muted"
                android:gravity="center"
                android:id="@id/raise_privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8.0dip" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:id="@id/raise_send"
            android:layout_width="fill_parent"
            android:layout_height="58.0dip"
            android:textAllCaps="false"
            app:cornerRadius="29.0dip"
            app:icon="@drawable/ic_support_send"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>