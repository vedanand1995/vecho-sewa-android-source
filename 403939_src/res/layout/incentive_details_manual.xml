<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="5.0dip"
    android:paddingBottom="5.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/parentLayout"
        android:background="@drawable/unselected_listview_button"
        android:padding="5.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/incentiveTitleLayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/incentiveForHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incentive for : "
                style="@style/CustomQuestionView" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/incentiveTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERM FP"
                android:paddingStart="5.0dip"
                style="@style/ListTitleView" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/attendedGroupLayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:gravity="center_vertical"
                android:id="@id/attendedLabelLayout"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="Attended"
                style="@style/CustomQuestionView" />
            <RadioGroup
                android:orientation="horizontal"
                android:id="@id/attendedRadioGroup"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@id/attendedYes"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="Yes" />
                <RadioButton
                    android:id="@id/attendedNo"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="No" />
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/memberCountLayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/totalMembersHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Members : "
                style="@style/CustomQuestionView" />
            <EditText
                android:id="@id/memberCountEditText"
                android:background="@drawable/custom_datepicker_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Enter Member Count"
                android:maxLength="3"
                android:layout_weight="1.0"
                android:inputType="number" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/locationLayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/locationHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attended Location : "
                style="@style/CustomQuestionView" />
            <EditText
                android:id="@id/locationEditText"
                android:background="@drawable/custom_datepicker_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Enter Location"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/dateLayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/dateHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date : "
                style="@style/CustomQuestionView" />
            <com.argusoft.sewa.android.app.component.IncentiveDateComponent
                android:id="@id/dateEditText"
                android:background="@drawable/custom_datepicker_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Click Here To Select Date"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/radioGroupLayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:gravity="center_vertical"
                android:id="@id/radioGroupHeading"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="Select"
                style="@style/CustomQuestionView" />
            <RadioGroup
                android:orientation="horizontal"
                android:id="@id/radioGroup"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@id/radioButtonYes"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="Yes" />
                <RadioButton
                    android:id="@id/radioButtonNo"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="No" />
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/adolescentLayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:gravity="center_vertical"
                android:id="@id/adolescentHeading"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="Select"
                style="@style/CustomQuestionView" />
            <RadioGroup
                android:orientation="horizontal"
                android:id="@id/adolescentsRadioGroup"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@id/adolescentsYes"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="Yes" />
                <RadioButton
                    android:id="@id/adolescentsNo"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="No" />
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/amountLayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/amountHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount Calculated : "
                style="@style/CustomQuestionView" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/amountCalculated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1000"
                android:paddingStart="5.0dip"
                style="@style/CustomAnswerView" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/multipleMamtaGroupLayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:gravity="center_vertical"
                android:id="@id/multipleMamtaLayout"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="Any more Mamta"
                style="@style/CustomQuestionView" />
            <RadioGroup
                android:orientation="horizontal"
                android:id="@id/mamtaRadioGroup"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@id/mamtaRadioButtonYes"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="Yes" />
                <RadioButton
                    android:id="@id/mamtaRadioButtonNo1"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="No" />
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/memberCountLayoutForMamta"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/totalMembersHeadingForMamta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Members : "
                style="@style/CustomQuestionView" />
            <EditText
                android:id="@id/memberCountEditTextForMamta"
                android:background="@drawable/custom_datepicker_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Enter Member Count"
                android:maxLength="3"
                android:layout_weight="1.0"
                android:inputType="numberSigned" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/locationLayoutForMamta"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/locationHeadingForMamta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attended Location : "
                style="@style/CustomQuestionView" />
            <EditText
                android:id="@id/locationEditTextForMamta"
                android:background="@drawable/custom_datepicker_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Enter Location"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/dateLayoutForMamta"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:id="@id/dateHeadingForMamta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date : "
                style="@style/CustomQuestionView" />
            <com.argusoft.sewa.android.app.component.IncentiveDateComponent
                android:id="@id/dateEditTextForMamta"
                android:background="@drawable/custom_datepicker_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Click Here To Select Date"
                android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/memberDetailsLayout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>