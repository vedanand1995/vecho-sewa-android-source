<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/listview_selector"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="5.0dip"
        android:paddingBottom="5.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10.0dip"
        android:paddingEnd="0.0dip">
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="@color/listview_text_color_selector"
            android:gravity="center_vertical"
            android:id="@id/notification_text_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/roboto_bold" />
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="14.0sp"
            android:textColor="@color/listview_text_color_selector"
            android:gravity="center_vertical"
            android:id="@id/notification_text_separator"
            android:paddingLeft="5.0dip"
            android:paddingRight="5.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dash"
            android:lines="1"
            android:fontFamily="@font/roboto_regular" />
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="@style/ListTextView"
            android:textSize="14.0sp"
            android:textColor="@color/listview_text_color_selector"
            android:gravity="center_vertical"
            android:id="@id/notification_text_regular"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginEnd="30.0dip" />
    </LinearLayout>
    <com.google.android.material.textview.MaterialTextView
        android:textAppearance="@style/ListTextView"
        android:textSize="14.0sp"
        android:textColor="@color/listview_text_color_selector"
        android:gravity="center_vertical"
        android:id="@id/notification_text_vaccines_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium"
        android:paddingStart="10.0dip"
        android:paddingEnd="0.0dip"
        android:layout_marginEnd="30.0dip" />
    <com.google.android.material.textview.MaterialTextView
        android:textAppearance="@style/ListTextView"
        android:textSize="12.0sp"
        android:textColor="@color/listview_text_color_selector"
        android:gravity="center_vertical"
        android:id="@id/notification_text_vaccines"
        android:paddingTop="2.0dip"
        android:paddingBottom="5.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_regular"
        android:paddingStart="10.0dip"
        android:paddingEnd="0.0dip"
        android:layout_marginEnd="30.0dip" />
</LinearLayout>